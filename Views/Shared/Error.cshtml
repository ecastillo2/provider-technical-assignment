@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    var code = Model.StatusCode?.ToString() ?? "Error";
    var isDev = string.Equals(
        Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment))
            is Microsoft.AspNetCore.Hosting.IWebHostEnvironment env ? env.EnvironmentName : "",
        "Development",
        StringComparison.OrdinalIgnoreCase);
}

<div class="error-card">
    <div class="error-code">@code</div>
    <h1 class="error-title">@Model.Title</h1>
    <p class="error-message">@Model.Message</p>

    @if (!string.IsNullOrEmpty(Model.OriginalPath))
    {
        <p class="error-path">
            <span class="error-label">Requested path</span>
            <code>@Model.OriginalPath</code>
        </p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="error-request-id">
            <span class="error-label">Request ID</span>
            <code>@Model.RequestId</code>
        </p>
    }

    <div class="error-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Open dashboard</a>
    </div>

    @if (isDev)
    {
        <hr />
        <p class="text-muted small mb-0">
            You are running in <strong>Development</strong>. Unhandled exceptions
            show a full stack trace via <code>UseDeveloperExceptionPage</code>;
            this friendly page only appears for explicit status-code responses.
        </p>
    }
</div>

<style>
    .error-card {
        max-width: 640px;
        margin: 3rem auto;
        padding: 2.5rem 2.25rem;
        background: var(--pm-surface, #fff);
        border: 1px solid var(--pm-border, #e6e8ef);
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .08);
        text-align: center;
    }
    .error-code {
        display: inline-block;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 2.75rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
        padding: .35rem .9rem;
        margin-bottom: 1rem;
        color: #fff;
        background: linear-gradient(135deg, #4f46e5 0%, #0ea5e9 100%);
        border-radius: 12px;
        box-shadow: 0 6px 16px rgba(79, 70, 229, .25);
    }
    .error-title {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: .5rem;
    }
    .error-message {
        color: var(--pm-text-muted, #475569);
        font-size: 1.02rem;
        margin-bottom: 1.5rem;
    }
    .error-path, .error-request-id {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: .55rem;
        margin: .25rem 0;
        font-size: .92rem;
    }
    .error-label {
        font-weight: 600;
        color: var(--pm-text-muted, #475569);
    }
    .error-path code, .error-request-id code {
        background: var(--pm-surface-2, #fafbff);
        border: 1px solid var(--pm-border, #e6e8ef);
        border-radius: 6px;
        padding: .15rem .45rem;
    }
    .error-actions {
        display: flex;
        gap: .65rem;
        justify-content: center;
        margin-top: 1.75rem;
        flex-wrap: wrap;
    }
</style>
