@model ProviderDetailsVm
@{
    ViewData["Title"] = $"Audit · {Model.ProviderName}";
}

<h1 class="h3 mb-1">Audit · @Model.ProviderName</h1>
<div class="text-muted small mb-3">Read-only view via .IgnoreQueryFilters()</div>

@if (Model.IsDeleted)
{
    <div class="alert alert-secondary">
        <strong>Deleted:</strong> @(Model.DeletedDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
        by @Model.DeletedBy
    </div>
}

<dl class="row">
    <dt class="col-sm-3">County</dt><dd class="col-sm-9">@Model.County</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime()</dd>
    <dt class="col-sm-3">Modified</dt><dd class="col-sm-9">@(Model.ModifiedDate?.ToLocalTime().ToString() ?? "—")</dd>
</dl>

<h2 class="h5 mt-4">Licenses (including soft-deleted)</h2>

@if (!Model.Licenses.Any())
{
    <div class="alert alert-light border">No licenses recorded.</div>
}
else
{
    <table class="table table-sm">
        <thead class="table-light">
            <tr><th>License #</th><th>Status</th><th>Expiration</th></tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Licenses)
        {
            <tr>
                <td>@l.LicenseNumber</td>
                <td>@l.LicenseStatus</td>
                <td>@l.ExpirationDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        </tbody>
    </table>
}

<div class="mt-3">
    @if (Model.IsDeleted)
    {
        <form asp-action="Restore" asp-route-id="@Model.ProviderId" method="post" class="d-inline">
            <button type="submit" class="btn btn-success">Restore Provider</button>
        </form>
    }
    <a asp-action="Deleted" class="btn btn-link">Back to audit list</a>
</div>
