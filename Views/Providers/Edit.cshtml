@model ProviderEditVm
@{
    ViewData["Title"] = $"Edit · {Model.ProviderName}";
}

<h1 class="h3 mb-3">Edit Provider</h1>

<form asp-action="Edit" asp-route-id="@Model.ProviderId" method="post" class="col-md-8">
    <input type="hidden" asp-for="ProviderId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" hidden></div>

    <div class="mb-3">
        <label asp-for="ProviderName" class="form-label"></label>
        <input asp-for="ProviderName" class="form-control" autofocus />
        <span asp-validation-for="ProviderName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="County" class="form-label"></label>
        <input asp-for="County" class="form-control" />
        <span asp-validation-for="County" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ProviderStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.ProviderId" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
