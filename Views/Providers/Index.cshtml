@using ProviderAssignmentStarter.ViewModels.Paging
@model PagedResult<ProviderListItemVm>
@{
    ViewData["Title"] = "Providers";
    var filter = ViewData["Filter"] as ProviderListFilter ?? new ProviderListFilter();
    var rows   = Model.Items;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Providers</h1>
    <div class="d-flex gap-2">
        <a asp-action="Export" class="btn btn-outline-secondary">Export CSV</a>
        <a asp-action="Create" class="btn btn-primary">+ New Provider</a>
    </div>
</div>

<p class="text-muted small">
    Soft-deleted providers are excluded from this list (enforced via DbContext global
    query filter). Visit <a asp-action="Deleted">Audit</a> to view or restore them.
</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label for="Search" class="form-label small text-muted mb-1">Search by name or county</label>
        <input type="text" class="form-control" id="Search" name="Search"
               value="@filter.Search" placeholder="e.g. Atlanta, Fulton" />
    </div>
    <div class="col-md-3">
        <label for="Status" class="form-label small text-muted mb-1">Status</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">— Any —</option>
            @foreach (var s in Enum.GetValues<ProviderStatus>())
            {
                if (filter.Status == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Apply</button>
        @if (filter.HasFilter)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!rows.Any())
{
    if (filter.HasFilter)
    {
        <div class="alert alert-info">
            No providers match the current filter.
            <a asp-action="Index" class="alert-link">Clear filter</a> to see everything.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No providers yet. <a asp-action="Create" class="alert-link">Create your first one</a>.
        </div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>County</th>
                    <th>Status</th>
                    <th class="text-end">Licenses</th>
                    <th class="text-end">Active</th>
                    <th class="text-end">Expired</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in rows)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@p.ProviderId">@p.ProviderName</a>
                    </td>
                    <td>@p.County</td>
                    <td>
                        @switch (p.Status)
                        {
                            case ProviderStatus.Active:   <span class="badge bg-success">Active</span>   break;
                            case ProviderStatus.Inactive: <span class="badge bg-secondary">Inactive</span> break;
                            case ProviderStatus.Pending:  <span class="badge bg-warning text-dark">Pending</span> break;
                        }
                    </td>
                    <td class="text-end">@p.TotalLicenseCount</td>
                    <td class="text-end">@p.ActiveLicenseCount</td>
                    <td class="text-end">
                        @if (p.ExpiredLicenseCount > 0)
                        {
                            <span class="text-danger fw-bold">@p.ExpiredLicenseCount</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                    </td>
                    <td>@p.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.ProviderId" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@p.ProviderId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@p.ProviderId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pager", new PagerModel(Model, new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase)
    {
        ["Search"]   = filter.Search,
        ["Status"]   = filter.Status,
        ["pageSize"] = Model.PageSize
    }))
}
