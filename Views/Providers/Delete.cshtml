@model ProviderDetailsVm
@{
    ViewData["Title"] = $"Delete · {Model.ProviderName}";
}

<h1 class="h3 text-danger mb-3">Soft-Delete Provider</h1>

<div class="alert alert-warning">
    This will mark the provider as deleted and cascade the soft-delete to its
    @Model.Licenses.Count licenses. The records remain in the database and can
    be restored from the Audit page.
</div>

<dl class="row">
    <dt class="col-sm-3">Provider</dt><dd class="col-sm-9">@Model.ProviderName</dd>
    <dt class="col-sm-3">County</dt><dd class="col-sm-9">@Model.County</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Licenses</dt><dd class="col-sm-9">@Model.Licenses.Count</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.ProviderId" method="post">
    <button type="submit" class="btn btn-danger">Confirm Soft-Delete</button>
    <a asp-action="Details" asp-route-id="@Model.ProviderId" class="btn btn-link">Cancel</a>
</form>
